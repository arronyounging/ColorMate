/* ColorMate 全局样式 */
/* 设计原则：极简、专业、高级感 */

page {
  --primary-color: #1A1A1A;
  --secondary-color: #666666;
  --light-color: #999999;
  --bg-color: #F5F5F5;
  --card-bg: #FFFFFF;
  --lab-bg: #FAFAFA;

  /* 色彩比例 */
  --main-ratio: 60%;
  --secondary-ratio: 30%;
  --accent-ratio: 10%;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC',
               'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--bg-color);
  color: var(--primary-color);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  min-height: 100vh;
  background-color: var(--bg-color);
}

/* 卡片基础样式 */
.card {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 按钮重置 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  line-height: inherit;
}

button::after {
  border: none;
}

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 多行省略 */
.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 动画 */
.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 触摸反馈 */
.touchable {
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.touchable:active {
  transform: scale(0.98);
  opacity: 0.9;
}
