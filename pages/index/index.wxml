<!-- 首页：灵感配方流 Palette Flow -->
<view class="container">
  <!-- 顶部品牌标识 -->
  <view class="header">
    <view class="brand">
      <text class="brand-name">ColorMate</text>
      <text class="brand-slogan">10 秒找到你的穿搭配色公式</text>
    </view>
  </view>

  <!-- 每日推荐提示 -->
  <view class="daily-tip" wx:if="{{showDailyTip}}">
    <text class="daily-icon">🌟</text>
    <text class="daily-text">今日推荐 · {{dailyTipText}}</text>
  </view>

  <!-- 氛围滤镜 -->
  <vibe-filter
    current="{{currentVibe}}"
    bindchange="onVibeChange"
  />

  <!-- 色彩探索提示 -->
  <view class="explore-toast {{showExploreToast ? 'show' : ''}}" wx:if="{{exploreColor}}">
    <view class="toast-color" style="background-color: {{exploreColor.hex}};"></view>
    <text class="toast-text">正在展示「{{exploreColor.name}}」的更多可能性...</text>
    <view class="toast-close" bindtap="clearExplore">×</view>
  </view>

  <!-- 配方卡片流 -->
  <scroll-view
    class="card-flow"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bindscrolltolower="onLoadMore"
    lower-threshold="300"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <view class="card-list">
      <colormate-card
        wx:for="{{palettes}}"
        wx:key="id"
        palette="{{item}}"
        index="{{index}}"
        animate="{{true}}"
        bindcardtap="onCardTap"
        bindcolorclick="onColorClick"
        bindcollectchange="onCollectChange"
      />
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <view class="loading-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
      <text class="loading-text">加载更多配方...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && palettes.length > 0}}">
      <text>已展示全部配方 · 下拉刷新发现新搭配</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{palettes.length === 0 && !loading}}">
      <text class="empty-icon">🎨</text>
      <text class="empty-title">暂无匹配的配方</text>
      <text class="empty-desc">试试其他筛选条件</text>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-bottom"></view>
  </scroll-view>

  <!-- 配方详情弹窗 -->
  <view class="detail-modal {{showDetail ? 'show' : ''}}" catchtap="closeDetail">
    <view class="detail-content" catchtap="preventClose" wx:if="{{detailPalette}}">
      <view class="detail-header">
        <text class="detail-emoji">{{detailPalette.emoji}}</text>
        <text class="detail-name">{{detailPalette.name}}</text>
        <view class="detail-close" bindtap="closeDetail">×</view>
      </view>

      <!-- 精简版解读 —— 标签化 -->
      <view class="insight-tags">
        <view class="tag-row">
          <text class="tag">💡 {{detailPalette.colors[0].name}} + {{detailPalette.colors[1].name}}</text>
          <text class="tag vibe-tag">{{vibeTagMap[detailPalette.vibe]}}</text>
        </view>
      </view>

      <view class="insight-section">
        <view class="insight-block">
          <text class="insight-label">为什么这么配？</text>
          <text class="insight-content">{{detailPalette.insight.why}}</text>
        </view>

        <view class="insight-block">
          <text class="insight-label">避坑指南</text>
          <text class="insight-content">{{detailPalette.insight.tips}}</text>
        </view>
      </view>

      <view class="detail-actions">
        <button class="action-btn secondary" bindtap="showPoster">
          生成海报
        </button>
        <button class="action-btn primary" open-type="share" data-palette="{{detailPalette}}">
          分享给好友
        </button>
      </view>
    </view>
  </view>

  <!-- 新手引导 -->
  <onboarding
    show="{{showOnboarding}}"
    bindcomplete="onOnboardingComplete"
  />

  <!-- 分享海报 -->
  <share-poster
    show="{{showSharePoster}}"
    palette="{{posterPalette}}"
    bindclose="closePoster"
  />
</view>
