/* 首页：灵感配方流样式 */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 顶部品牌区 */
.header {
  padding: 32rpx 40rpx 16rpx;
  background-color: #F5F5F5;
}

.brand {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 色彩探索提示 */
.explore-toast {
  position: fixed;
  top: 200rpx;
  left: 32rpx;
  right: 32rpx;
  background-color: #1A1A1A;
  color: #FFFFFF;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  z-index: 200;
  opacity: 0;
  transform: translateY(-20rpx);
  transition: all 0.3s ease;
  pointer-events: none;
}

.explore-toast.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.toast-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.toast-text {
  flex: 1;
  font-size: 26rpx;
}

.toast-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 卡片流 */
.card-flow {
  flex: 1;
  height: 0;
}

.card-list {
  padding: 16rpx 32rpx;
}

/* 加载更多 */
.load-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #CCCCCC;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.loading-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #CCCCCC;
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #666666;
  font-weight: 500;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 底部安全区 */
.safe-bottom {
  height: 120rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
  transition: background-color 0.3s ease;
}

.detail-modal.show {
  background-color: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.detail-content {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.detail-modal.show .detail-content {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.detail-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.detail-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.detail-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999999;
  background-color: #F5F5F5;
  border-radius: 50%;
}

/* 解读区块 */
.insight-section {
  margin-bottom: 32rpx;
}

.insight-block {
  background-color: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.insight-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 分享按钮 */
.share-btn {
  width: 100%;
  height: 96rpx;
  background-color: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-btn::after {
  border: none;
}
