/* 收藏页面样式 */

.container {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header {
  padding: 40rpx 40rpx 24rpx;
  background-color: #FFFFFF;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999999;
}

/* 收藏列表 */
.collection-scroll {
  flex: 1;
  height: 0;
}

.collection-list {
  padding: 24rpx 32rpx;
}

/* 空状态 */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  margin-bottom: 48rpx;
}

.explore-btn {
  padding: 24rpx 64rpx;
  background-color: #1A1A1A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
}

.explore-btn::after {
  border: none;
}

/* 底部安全区 */
.safe-bottom {
  height: 120rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  pointer-events: none;
  transition: background-color 0.3s ease;
}

.detail-modal.show {
  background-color: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.detail-content {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.detail-modal.show .detail-content {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.detail-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.detail-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.detail-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999999;
  background-color: #F5F5F5;
  border-radius: 50%;
}

/* 解读区块 */
.insight-section {
  margin-bottom: 32rpx;
}

.insight-block {
  background-color: #FAFAFA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.insight-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.insight-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn.danger {
  background-color: #FFF0F0;
  color: #FF6B6B;
}

.action-btn.primary {
  background-color: #1A1A1A;
  color: #FFFFFF;
}
