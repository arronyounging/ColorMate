/* 自定义 TabBar 样式 */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  transition: all 0.2s ease;
}

.tab-bar-item:active {
  opacity: 0.7;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.icon-text {
  font-size: 40rpx;
  transition: transform 0.2s ease;
}

.tab-bar-item.active .icon-text {
  transform: scale(1.1);
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  transition: color 0.2s ease;
}

.tab-bar-item.active .tab-text {
  color: #1A1A1A;
  font-weight: 500;
}
