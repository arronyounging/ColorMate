/* 新手引导样式 */

.onboarding {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background-color: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s ease;
}

.onboarding.visible {
  background-color: rgba(0, 0, 0, 0.85);
  opacity: 1;
  pointer-events: auto;
}

.onboarding-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 48rpx;
  box-sizing: border-box;
}

/* 步骤指示器 */
.step-dots {
  display: flex;
  gap: 16rpx;
  margin-bottom: 80rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  transition: all 0.3s ease;
}

.dot.active {
  background-color: #FFFFFF;
  width: 40rpx;
  border-radius: 8rpx;
}

/* 步骤内容 */
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: stepFadeIn 0.4s ease;
}

@keyframes stepFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 视觉演示区 */
.step-visual {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 60rpx;
}

/* 欢迎页色块 */
.welcome-colors {
  display: flex;
  gap: 24rpx;
}

.w-color {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  animation: colorFloat 3s ease-in-out infinite;
}

.w-color:nth-child(1) { animation-delay: 0s; }
.w-color:nth-child(2) { animation-delay: 0.4s; }
.w-color:nth-child(3) { animation-delay: 0.8s; }

@keyframes colorFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

/* 色条演示 */
.demo-bar {
  display: flex;
  width: 520rpx;
  height: 100rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}

.demo-segment {
  position: relative;
  height: 100%;
}

.demo-segment.main {
  flex: 6;
  border-radius: 20rpx 0 0 20rpx;
}

.demo-segment.secondary { flex: 3; }
.demo-segment.accent {
  flex: 1;
  border-radius: 0 20rpx 20rpx 0;
}

/* 点击提示 */
.tap-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tap-circle {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  animation: tapPulse 1.5s ease-in-out infinite;
}

@keyframes tapPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.3);
    opacity: 0.5;
  }
}

.tap-text {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

/* 相机演示 */
.demo-camera {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.camera-icon {
  font-size: 80rpx;
  animation: cameraShake 2s ease-in-out infinite;
}

@keyframes cameraShake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-5deg); }
  75% { transform: rotate(5deg); }
}

.camera-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.5);
}

.demo-card-mini {
  width: 200rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 16rpx;
}

.mini-bar {
  display: flex;
  height: 40rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.mini-bar > view {
  height: 100%;
}

.mini-label {
  font-size: 20rpx;
  color: #666666;
  text-align: center;
  display: block;
}

/* 文字内容 */
.step-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  line-height: 1.4;
  margin-bottom: 24rpx;
  white-space: pre-line;
}

.step-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 80rpx;
  white-space: pre-line;
}

/* 按钮 */
.next-btn {
  width: 400rpx;
  height: 96rpx;
  background-color: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.2s ease;
}

.next-btn::after {
  border: none;
}

.next-btn:active {
  background-color: rgba(255, 255, 255, 0.25);
  transform: scale(0.97);
}

.next-btn.primary {
  background-color: #FFFFFF;
  color: #1A1A1A;
  border: none;
}

.next-btn.primary:active {
  background-color: rgba(255, 255, 255, 0.9);
}

/* 跳过 */
.skip-btn {
  position: absolute;
  top: 100rpx;
  right: 48rpx;
  padding: 16rpx 32rpx;
}

.skip-btn text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.4);
}
