/* 分享海报样式 */

.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  background-color: rgba(0, 0, 0, 0);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transition: background-color 0.3s ease;
}

.poster-modal.visible {
  background-color: rgba(0, 0, 0, 0.7);
  pointer-events: auto;
}

.poster-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0.9);
  opacity: 0;
  transition: all 0.3s ease;
}

.poster-modal.visible .poster-wrapper {
  transform: scale(1);
  opacity: 1;
}

.poster-canvas {
  border-radius: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.poster-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.poster-btn {
  padding: 20rpx 48rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.poster-btn::after {
  border: none;
}

.poster-btn.save {
  background-color: #FFFFFF;
  color: #1A1A1A;
}

.poster-btn.share {
  background-color: rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.poster-close {
  position: absolute;
  top: -80rpx;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.6);
}
