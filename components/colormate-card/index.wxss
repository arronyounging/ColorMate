/* ColorMate Card 颜伴卡样式 */
/* 设计原则：专业感、高级感、清晰的功能分区 */

.colormate-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

/* A区：色彩实验室 */
.lab-section {
  position: relative;
  padding: 40rpx;
  background-color: #FAFAFA;
}

.lab-bg {
  position: relative;
}

/* 配方标题 */
.formula-header {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.formula-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.formula-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

/* 色号标注区 */
.color-labels {
  margin-top: 32rpx;
}

.color-label {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.color-label:last-child {
  border-bottom: none;
}

.color-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.color-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.color-name {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.color-hex {
  font-size: 22rpx;
  color: #999999;
  font-family: 'SF Mono', 'Menlo', monospace;
  margin-top: 4rpx;
}

.color-ratio {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
  min-width: 60rpx;
  text-align: right;
}

/* 收藏按钮 */
.collect-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.collect-btn:active {
  transform: scale(1.2);
}

.collect-icon {
  font-size: 48rpx;
  color: #CCCCCC;
  transition: color 0.3s ease;
}

.collect-btn.collected .collect-icon {
  color: #FF6B6B;
}

/* B区：视觉验证场 */
.proof-section {
  position: relative;
  width: 100%;
  /* 65% 的视觉比重，使用宽高比实现 */
  padding-bottom: 120%;
  overflow: hidden;
}

.outfit-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 图片占位 */
.image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
}

.placeholder-colors {
  display: flex;
  width: 60%;
  height: 120rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.placeholder-color {
  height: 100%;
}

.placeholder-text {
  font-size: 24rpx;
  color: #999999;
}

/* 动画效果 */
.colormate-card.fade-in {
  animation: cardFadeIn 0.4s ease-out;
}

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 点击反馈 */
.colormate-card:active {
  transform: scale(0.995);
  transition: transform 0.15s ease;
}
