<!-- Color Bar 动态比例色条组件 -->
<!-- 直观展示 主色(60%) / 辅色(30%) / 点缀色(10%) 的比例关系 -->
<view class="color-bar">
  <view
    wx:for="{{colors}}"
    wx:key="hex"
    class="color-segment {{item.role}}"
    style="flex: {{item.ratio}}; background-color: {{item.hex}};"
    data-color="{{item}}"
    bindtap="onSegmentTap"
  >
    <!-- 悬浮提示（点击时显示） -->
    <view class="color-tooltip" wx:if="{{activeColor === item.hex}}">
      <text class="tooltip-name">{{item.name}}</text>
      <text class="tooltip-ratio">{{item.ratio}}%</text>
    </view>
  </view>
</view>

<!-- 比例说明 -->
<view class="ratio-legend" wx:if="{{showLegend}}">
  <view class="legend-item">
    <text class="legend-label">主色</text>
    <text class="legend-value">60%</text>
  </view>
  <view class="legend-item">
    <text class="legend-label">辅色</text>
    <text class="legend-value">30%</text>
  </view>
  <view class="legend-item">
    <text class="legend-label">点缀</text>
    <text class="legend-value">10%</text>
  </view>
</view>
